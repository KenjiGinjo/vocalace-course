---
const { title, lesson } = Astro.locals.starlightRoute.entry.data
---

{
  lesson ? (
    <p class="lesson-label">{lesson}</p>
  ) : null
}
<h1 id="_top">{title}</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 0.35rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
