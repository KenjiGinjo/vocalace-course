---
/**
 * Header ad slot: CTA into Vocalace practice (replaces social icons).
 * Absolute host so local `courses` dev still lands on the real product.
 */
const practiceHref = 'https://vocalace.com/practice'
---

<a class="practice-cta" href={practiceHref} title="打开 Vocalace，跟读并纠音">
	去练习
</a>

<style>
	.practice-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 2rem;
		padding: 0 0.9rem;
		border-radius: 0.625rem;
		background: oklch(0.45 0.09 185);
		color: oklch(0.99 0.01 82);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition: background 0.15s ease;
	}

	.practice-cta:hover {
		background: oklch(0.4 0.09 185);
		color: oklch(0.99 0.01 82);
	}

	.practice-cta:focus-visible {
		outline: 2px solid oklch(0.45 0.09 185);
		outline-offset: 2px;
	}

	:global(.mobile-preferences) .practice-cta {
		height: 2.5rem;
		padding-inline: 1rem;
		font-size: 0.875rem;
	}

	:root[data-theme='dark'] .practice-cta {
		background: oklch(0.75 0.1 185);
		color: oklch(0.18 0.02 185);
	}

	:root[data-theme='dark'] .practice-cta:hover {
		background: oklch(0.8 0.09 185);
		color: oklch(0.18 0.02 185);
	}
</style>
