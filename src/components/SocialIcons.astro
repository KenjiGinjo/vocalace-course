---
/**
 * Header action: Star the open-source course repo.
 */
import { Icon } from '@astrojs/starlight/components'

const repoHref = 'https://github.com/KenjiGinjo/vocalace-course'
---

<div class="header-actions">
	<a
		class="star-cta"
		href={repoHref}
		target="_blank"
		rel="noopener noreferrer"
		title="在 GitHub 上 Star 本课程仓库"
	>
		<Icon name="github" size="1.05rem" />
		<span>Star</span>
	</a>
</div>

<style>
	.header-actions {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.star-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		height: 2rem;
		padding: 0 0.75rem;
		border-radius: 0.625rem;
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
		border: 1px solid var(--sl-color-hairline);
		background: transparent;
		color: var(--sl-color-gray-2);
	}

	.star-cta:hover {
		border-color: var(--sl-color-gray-3);
		color: var(--sl-color-white);
	}

	.star-cta:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.star-cta :global(svg) {
		flex-shrink: 0;
	}

	:global(.mobile-preferences) .header-actions {
		gap: 0.6rem;
	}

	:global(.mobile-preferences) .star-cta {
		height: 2.5rem;
		padding-inline: 1rem;
		font-size: 0.875rem;
	}
</style>
